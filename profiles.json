  "activation": {
   "offset": "0x3B",
   "value": 8,
   "_comment": "ReFlasher 'Activate ESC' (default: on)"
  },
  "sn": {
   "offset": "0x20",
   "length": 14
  },
  "mileage": {
   "offset": "0x52",
   "size": 4,
   "unit": "meter = km*1000, int32 little endian"
  },
  "uid": {
   "offset": "0x1B4",
   "length": 12,
   "_comment": "ReFlasher 'Copy CPUID' (default: on)"
  }
 },
 "_webflasher_facts": {
  "drv_flow": "Remove RDP, reset, read UID, one image: bootloader@0x0, firmware@0x1000, user data@0x1C000 (Ninebot) / 0xF800 (Xiaomi)",
  "bootloader": {
   "ninebot": "nb_DRV_AT32.bin if MCU=AT32 else nb_DRV.bin",
   "xiaomi": "mi_DRV_GD32.bin if GD32 else mi_DRV.bin"
  },
  "ble_nrf51": {
   "erase": "NVMC erase all",
   "softdevice+bootloader": "nb_BLE.bin|mi_BLE.bin|mi_BLE_V2.bin @0x0",
   "firmware": "0x18000 (V1) / 0x1B000 (V2: pro2,1s,lite,mi3)",
   "uicr_0x10001014": "0x3C000 (V1) / 0x3D000 (V2)",
   "bootsettings": "boot-16k @0x3C000 / boot-32k @0x3D000",
   "name_page": {
    "addr": "0x3B400 (V1) / 0x3B800 (V2)",
    "bytes": "55 AA 00*6 + Name(13 Bytes ab Offset 8, Standard 'NBScooter0000'/'MIScooter0000')"
   }
  }
 },
